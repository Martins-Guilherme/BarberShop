# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
DATABASE_URL="STRING DE CONEXÃO COM O BANCO DE DADOS"


## https://console.cloud.google.com
AUTH_GOOGLE_ID="IDENTIFICADOR DO CLIENT GOOGLE CLOUD CONSOLE"
AUTH_GOOGLE_SECRET="SENHA DO CLIENT PARA O GOOGLE CLOUD CONSOLE"

# SERVIR A APLICAÇÃO LOCALMENTE E CONSEGUIR AUTENTICAR
NEXTAUTH_URL="http://localhost:3000"

For development: http://localhost:3000/api/auth/callback/google
For production: https://{YOUR_DOMAIN}/api/auth/callback/google


# PARA A CONFIGURAÇÃO DO NEXTAUTH
NEXTAUTH_SECRET="CHAVE SECRETA"
NEXT_AUTH_SECRET="CHAVE SECRETA"


